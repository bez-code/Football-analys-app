{
  "name": "tactix",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first football video analysis, tactical metrics and skill assessment",
  "main": "./out/main/index.js",
  "author": "Tactix",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "npm run build && electron-builder --mac --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke": "npm run smoke:build && node scripts/run-smoke.mjs",
    "smoke:build": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --target=node20 --packages=external --alias:@tactix/contracts=../../packages/contracts/src/index.ts --outfile=out/smoke/smoke.mjs"
  },
  "dependencies": {
    "@tactix/contracts": "*",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "konva": "^10.7.0",
    "lucide-react": "^0.545.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "react-konva": "^19.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
